# ===== Slack =====
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-socket-mode-token

# ===== LLM (pydantic-ai) =====
# 使用 ANTHROPIC_API_KEY 或 pydantic-ai 标准环境变量
ANTHROPIC_API_KEY=sk-ant-your-key
MODEL_LIGHT_PRIMARY=claude-sonnet-4-5
MODEL_LIGHT_FALLBACK=claude-3-5-haiku
MODEL_FULL=claude-opus-4-8

# ===== Database (SQLAlchemy async) =====
DATABASE_URL=postgresql+asyncpg://teamai:teamai@localhost:5432/teamai

# ===== Redis / Queue =====
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=teamai-tasks

# ===== Vector (Qdrant) =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=teamai-memory

# ===== Budget (token 上限) =====
BUDGET_PERIOD=MONTHLY

# ===== Admin API =====
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8000
