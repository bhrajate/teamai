# TeamAI 环境变量示例
#
# 用法：拷一份为 .env（已在 .gitignore 中）。
#   cp .env.example .env
#
# 这里只放**凭据与连接串** —— 每套环境都不同，且不该出现在任何可能被提交的
# 文件里。非敏感可调项（模型分级、端口、队列名、上下文阈值等）见
# config.example.yaml。
#
# 优先级：环境变量 > .env > config.yaml > 代码里的字段默认值。
# 因此这里的任何一项也可以用来临时覆盖 config.yaml 的取值，
# 变量名即展平后的字段名大写，如 MODEL_FULL、ADMIN_API_PORT。

# ===== Slack =====
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
# 配了走 Socket Mode，留空走 Events API（需公网可达的回调 URL）
SLACK_APP_TOKEN=xapp-your-socket-mode-token

# ===== 飞书 =====
FEISHU_APP_ID=cli_your-app-id
FEISHU_APP_SECRET=your-app-secret
# 以下两项仅 callback（HTTP 回调）模式需要；留空且配了上面两项时
# 自动走 ws 长连接（见 config.example.yaml 的 platforms.feishu.mode）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ===== LLM 凭据与端点 =====
# 用哪家、走哪个协议由 config.yaml 的 model.* 决定（`provider:model` 前缀），
# 故 key 不再专属 Anthropic。这两项要与那三行**配套**改，否则 401 或打错端点。
# 旧名 ANTHROPIC_API_KEY 仍可用（等价，新名优先），已有 .env 无须改动。
LLM_API_KEY=sk-your-key

# 自定义端点（中转站、自建网关、内网代理）。留空走各 provider 的官方地址。
#LLM_BASE_URL=https://your-gateway.example.com/v1

# 成套配法（model.* 取值 → 这里填什么），完整例子见 config.example.yaml 的 model 段：
#
#   claude-*（裸名）/ anthropic:*   官方：留空 | 中转：填中转地址
#   openai-chat:*                   网关地址，通常带 /v1
#   openai:*                        官方：留空 | 中转：填中转地址
#   deepseek:* moonshotai:* zai:*   留空（自带端点，填了也被忽略）
#   ollama:*                        http://localhost:11434/v1，KEY 随便填非空值
#
# ⚠️ 留空时各家 SDK 仍会自读它认的环境变量（ANTHROPIC_BASE_URL、OPENAI_BASE_URL
# 等），shell 里设过就会悄悄生效。要确定性就把这项显式填上。

# ===== Admin API 访问令牌 =====
# 留空则 /api 全部匿名可用。上面挂着完整审计日志、频道记忆，以及**可写**的
# 预算配额与工具白名单 —— 也就是说能访问这个端口的人都能改工具权限、
# 把配额调到无限。admin_api.host 默认 0.0.0.0，公网或办公网可达时务必配上。
#
# 客户端带 `Authorization: Bearer <token>`。控制台前端在「设置」页填一次，
# 存在浏览器 localStorage 里（不打进构建产物 —— 产物是静态文件，谁都能下载）。
#
# 注意这不是登录：后端只认这一个共享令牌，没有用户概念，故无法按人区分权限，
# 也无法单独吊销某个人。要那些能力得先在后端引入会话与用户模型。
#
# `/api/health` 有意不在保护范围内，好让探针与 make verify-* 匿名可打。
#ADMIN_API_TOKEN=

# ===== 连接串 =====
DATABASE_URL=postgresql+asyncpg://teamai:teamai@localhost:5432/teamai
REDIS_URL=redis://localhost:6379/0
# 集合名不在这里，见 config/config.example.yaml 的 qdrant.collection
QDRANT_URL=http://localhost:6333

# ===== 依赖容器的宿主端口（deploy/docker-compose.yml 读这几个）=====
# 开发机上常已跑着别的 postgres/redis/qdrant，端口撞了 make up 就起不来。
# 改这里换宿主端口，容器内端口不变；记得把上面的连接串也指到新端口。
# 留空即用默认值 5432 / 6379 / 6333。
#POSTGRES_PORT=15432
#REDIS_PORT=16379
#QDRANT_PORT=16333
